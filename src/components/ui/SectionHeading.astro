---
interface Props {
  eyebrow?: string;
  title: string;
  supporting?: string;
  align?: 'left' | 'center';
  class?: string;
  onDark?: boolean;
  id?: string;
}

const { eyebrow, title, supporting, align = 'left', class: className = '', onDark = false, id } = Astro.props;
const classes = `section-heading section-heading--${align} ${onDark ? 'section-heading--on-dark' : ''} ${className}`;
---

<div class={classes}>
  {eyebrow && <span class="section-heading__eyebrow">{eyebrow}</span>}
  <h2 class="section-heading__title" id={id}>{title}</h2>
  {supporting && <p class="section-heading__supporting">{supporting}</p>}
</div>

<style>
  .section-heading {
    margin-bottom: 2.5rem;
  }

  .section-heading--center {
    text-align: center;
    margin-inline: auto;
  }

  .section-heading__eyebrow {
    display: inline-block;
    margin-bottom: 0.75rem;
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
  }

  .section-heading__title {
    max-width: 720px;
    font-size: var(--heading-md);
    font-weight: 700;
    line-height: 1.1;
    color: var(--text);
  }

  .section-heading--center .section-heading__title {
    margin-inline: auto;
  }

  .section-heading__supporting {
    max-width: 680px;
    margin-top: 1rem;
    font-size: var(--text-xl);
    line-height: 1.55;
    color: var(--text-muted);
  }

  .section-heading--center .section-heading__supporting {
    margin-inline: auto;
  }
</style>
