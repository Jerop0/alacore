---
import { VISIBLE_LOCALES, LOCALES_WITH_LABELS, type Locale } from '../../lib/config';
import { localizePath } from '../../lib/i18n';

interface Props {
  currentLocale: Locale;
  path: string;
  inDrawer?: boolean;
}

const { currentLocale, path, inDrawer = false } = Astro.props;
const baseClass = `language-switcher ${inDrawer ? 'language-switcher--drawer' : ''}`;
---

<nav class={baseClass} aria-label="Language switcher">
  <ul class="language-switcher__list">
    {
      VISIBLE_LOCALES.map((locale) => {
        const href = localizePath(path, locale, currentLocale);
        const isActive = locale === currentLocale;
        return (
          <li>
            <a
              href={href}
              hreflang={locale}
              aria-current={isActive ? 'true' : undefined}
              class={`language-switcher__link ${isActive ? 'language-switcher__link--active' : ''}`}
              data-locale={locale}
            >
              {LOCALES_WITH_LABELS[locale]}
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>

<script>
  (function () {
    document.querySelectorAll('.language-switcher__link').forEach((link) => {
      link.addEventListener('click', () => {
        const locale = (link as HTMLElement).dataset.locale;
        if (locale) localStorage.setItem('ala-locale', locale);
      });
    });
  })();
</script>

<style>
  .language-switcher__list {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    list-style: none;
  }

  .language-switcher__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 40px;
    height: 32px;
    padding: 0 0.5rem;
    border-radius: 6px;
    font-size: var(--text-sm);
    font-weight: 600;
    color: rgba(255, 255, 255, 0.7);
    transition: background-color 160ms var(--ease-out-expo), color 160ms var(--ease-out-expo);
  }

  .language-switcher__link:hover {
    color: var(--ala-pure-white);
    background-color: rgba(255, 255, 255, 0.1);
  }

  .language-switcher__link--active {
    color: var(--ala-pure-white);
    background-color: rgba(255, 255, 255, 0.15);
  }

  .language-switcher--drawer .language-switcher__list {
    justify-content: center;
  }

  .language-switcher--drawer .language-switcher__link {
    height: 44px;
    min-width: 56px;
    font-size: var(--text-md);
  }
</style>
