---
import { DEFAULT_LOCALE, WHATSAPP_NUMBER, type Locale } from '../../lib/config';
import type { CopyNode } from '../../lib/i18n';
import copy from '../../content/site-copy.json';

const currentLocale = Astro.currentLocale as Locale ?? DEFAULT_LOCALE;
const localeCopy = (copy as Record<string, CopyNode>)[currentLocale] ?? copy[DEFAULT_LOCALE];
const askAla = localeCopy.askAla as CopyNode;
---

<div
  class="ask-ala-panel"
  id="ask-ala-panel"
  role="dialog"
  aria-modal="true"
  aria-label={String(askAla.panelTitle ?? 'Ask ALA')}
  aria-hidden="true"
  data-copy={JSON.stringify(askAla)}
  data-locale={currentLocale}
  data-number={WHATSAPP_NUMBER}
>
  <div class="ask-ala-panel__backdrop" id="ask-ala-backdrop"></div>
  <div class="ask-ala-panel__sheet" id="ask-ala-sheet">
    <div class="ask-ala-panel__handle" aria-hidden="true"></div>
    <div class="ask-ala-panel__header">
      <div class="ask-ala-panel__title-wrap">
        <span class="ask-ala-panel__avatar" aria-hidden="true">A</span>
        <div class="ask-ala-panel__title-group">
          <h2 class="ask-ala-panel__title">{String(askAla.panelTitle ?? 'Ask ALA')}</h2>
        </div>
      </div>
      <button type="button" class="ask-ala-panel__close" id="ask-ala-close" aria-label={String(askAla.close ?? 'Close')}>
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </div>
    <div class="ask-ala-panel__body" id="ask-ala-body" aria-live="polite"></div>
  </div>
</div>

<script>
  (function () {
    type ChoiceMap = Record<string, string[]>;
    type RecMap = Record<string, string[]>;
    interface Copy {
      panelTitle?: string;
      close?: string;
      question: string;
      choices: string[];
      followUp: Record<string, string>;
      followUpChoices: ChoiceMap;
      recommendation: string;
      recommendations: RecMap;
      next: string;
      actions: string[];
    }

    const panel = document.getElementById('ask-ala-panel');
    const body = document.getElementById('ask-ala-body');
    const closeBtn = document.getElementById('ask-ala-close');
    const backdrop = document.getElementById('ask-ala-backdrop');
    const sheet = document.getElementById('ask-ala-sheet');
    if (!panel || !body || !closeBtn || !backdrop || !sheet) return;

    const raw = panel.dataset.copy;
    const locale = panel.dataset.locale ?? 'en';
    const number = panel.dataset.number ?? '4917621812212';
    const copy: Copy = raw ? JSON.parse(raw) : {} as Copy;

    let state: {
      goal?: string;
      channel?: string;
    } = {};

    const setOpen = (open: boolean) => {
      panel.classList.toggle('is-open', open);
      panel.setAttribute('aria-hidden', String(!open));
      document.body.classList.toggle('no-scroll', open);
      if (open) {
        renderIntro();
        setTimeout(() => {
          const first = body.querySelector<HTMLElement>('button, a');
          first?.focus();
        }, 0);
      } else {
        const opener = document.getElementById('ask-ala-button') as HTMLElement | null;
        opener?.focus();
      }
    };

    const escapeHtml = (str: string) => {
      const div = document.createElement('div');
      div.textContent = str;
      return div.innerHTML;
    };

    const renderIntro = () => {
      state = {};
      body.innerHTML = `
        <div class="ask-ala-panel__messages">
          <div class="ask-ala-panel__message ask-ala-panel__message--assistant">
            <p class="ask-ala-panel__question">${escapeHtml(copy.question)}</p>
          </div>
        </div>
        <div class="ask-ala-panel__choices">
          ${copy.choices.map((choice, index) => `
            <button type="button" class="ask-ala-panel__choice" data-choice-index="${index}">${escapeHtml(choice)}</button>
          `).join('')}
        </div>
      `;
      bindChoices();
    };

    const bindChoices = () => {
      body.querySelectorAll<HTMLButtonElement>('[data-choice-index]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const index = Number(btn.dataset.choiceIndex);
          const keys = ['customers', 'time', 'operations', 'reports'];
          const key = keys[index];
          const choiceText = copy.choices[index];
          state.goal = key;
          appendUserBubble(choiceText);
          renderTyping(() => renderFollowUp(key));
        });
      });
    };

    const appendUserBubble = (text: string) => {
      const messages = body.querySelector('.ask-ala-panel__messages');
      if (!messages) return;
      const bubble = document.createElement('div');
      bubble.className = 'ask-ala-panel__message ask-ala-panel__message--user';
      bubble.innerHTML = `<p>${escapeHtml(text)}</p>`;
      messages.appendChild(bubble);
      scrollToBottom();
    };

    const appendAssistantBubble = (text: string) => {
      const messages = body.querySelector('.ask-ala-panel__messages');
      if (!messages) return;
      const bubble = document.createElement('div');
      bubble.className = 'ask-ala-panel__message ask-ala-panel__message--assistant';
      bubble.innerHTML = `<p>${escapeHtml(text)}</p>`;
      messages.appendChild(bubble);
      scrollToBottom();
    };

    const renderTyping = (then: () => void) => {
      const choices = body.querySelector('.ask-ala-panel__choices');
      if (choices) choices.innerHTML = '<div class="ask-ala-panel__typing"><span></span><span></span><span></span></div>';
      scrollToBottom();
      setTimeout(() => {
        then();
      }, 400);
    };

    const scrollToBottom = () => {
      const messages = body.querySelector('.ask-ala-panel__messages');
      if (messages) messages.scrollTop = messages.scrollHeight;
    };

    const renderFollowUp = (key: string) => {
      const question = copy.followUp[key] ?? '';
      const choices = copy.followUpChoices[key] ?? [];
      body.innerHTML = `
        <div class="ask-ala-panel__messages">
          <div class="ask-ala-panel__message ask-ala-panel__message--assistant">
            <p>${escapeHtml(question)}</p>
          </div>
        </div>
        <div class="ask-ala-panel__choices">
          ${choices.map((choice) => `
            <button type="button" class="ask-ala-panel__choice" data-followup="${escapeHtml(choice)}">${escapeHtml(choice)}</button>
          `).join('')}
        </div>
      `;
      body.querySelectorAll<HTMLButtonElement>('[data-followup]').forEach((btn) => {
        btn.addEventListener('click', () => {
          appendUserBubble(btn.textContent ?? '');
          renderTyping(() => renderRecommendation(key));
        });
      });
    };

    const renderRecommendation = (key: string) => {
      const recs = copy.recommendations[key] ?? [];
      const [whatsappLabel, contactLabel] = copy.actions;
      body.innerHTML = `
        <div class="ask-ala-panel__messages">
          <div class="ask-ala-panel__message ask-ala-panel__message--assistant">
            <p>${escapeHtml(copy.recommendation)}:</p>
            <ul class="ask-ala-panel__recs">
              ${recs.map((rec) => `<li>${escapeHtml(rec)}</li>`).join('')}
            </ul>
            <p class="ask-ala-panel__next">${escapeHtml(copy.next)}</p>
          </div>
        </div>
        <div class="ask-ala-panel__choices">
          <button type="button" class="ask-ala-panel__choice" data-action="whatsapp">${escapeHtml(whatsappLabel)}</button>
          <button type="button" class="ask-ala-panel__choice ask-ala-panel__choice--secondary" data-action="contact">${escapeHtml(contactLabel)}</button>
        </div>
      `;
      body.querySelectorAll<HTMLButtonElement>('[data-action]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const action = btn.dataset.action;
          if (action === 'whatsapp') {
            const goalText = copy.choices[['customers', 'time', 'operations', 'reports'].indexOf(state.goal ?? '')] ?? '';
            const message = encodeURIComponent(`Hello, I would like to improve: ${goalText}. I learned about this through Ask ALA on your website.`);
            window.open(`https://wa.me/${number}?text=${message}`, '_blank', 'noopener,noreferrer');
          } else if (action === 'contact') {
            window.location.href = `/${locale === 'en' ? '' : locale + '/'}contact`;
          }
        });
      });
    };

    window.addEventListener('open-ask-ala', () => setOpen(true));

    closeBtn.addEventListener('click', () => setOpen(false));
    backdrop.addEventListener('click', () => setOpen(false));

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && panel.classList.contains('is-open')) {
        setOpen(false);
      }
    });
  })();
</script>

<style>
  .ask-ala-panel {
    position: fixed;
    inset: 0;
    z-index: var(--z-panel);
    display: none;
  }

  .ask-ala-panel.is-open {
    display: block;
  }

  .ask-ala-panel__backdrop {
    position: absolute;
    inset: 0;
    background-color: rgba(11, 18, 32, 0.45);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    opacity: 0;
    transition: opacity 280ms var(--ease-out-expo);
  }

  .ask-ala-panel.is-open .ask-ala-panel__backdrop {
    opacity: 1;
  }

  .ask-ala-panel__sheet {
    position: absolute;
    right: 1.5rem;
    bottom: 1.5rem;
    width: min(calc(100% - 3rem), 440px);
    max-height: calc(100vh - 3rem);
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: 20px;
    background-color: var(--bg);
    box-shadow:
      0 24px 64px rgba(11, 18, 32, 0.14),
      0 8px 20px rgba(11, 18, 32, 0.06);
    transform: translateY(16px) scale(0.97);
    opacity: 0;
    transition:
      transform 280ms var(--ease-out-expo),
      opacity 280ms var(--ease-out-expo);
  }

  .ask-ala-panel.is-open .ask-ala-panel__sheet {
    transform: translateY(0) scale(1);
    opacity: 1;
  }

  .ask-ala-panel__handle {
    display: none;
    width: 36px;
    height: 4px;
    margin: 0.625rem auto 0;
    border-radius: 999px;
    background-color: var(--line);
  }

  @media (max-width: 640px) {
    .ask-ala-panel__sheet {
      right: 0;
      bottom: 0;
      width: 100%;
      max-height: 92vh;
      padding-bottom: env(safe-area-inset-bottom);
      border-radius: 20px 20px 0 0;
      transform: translateY(100%);
    }

    .ask-ala-panel.is-open .ask-ala-panel__sheet {
      transform: translateY(0);
    }

    .ask-ala-panel__handle {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ask-ala-panel__backdrop,
    .ask-ala-panel__sheet {
      transition: none;
    }
  }

  .ask-ala-panel__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 1.25rem 1.25rem 1rem;
    border-bottom: 1px solid var(--line);
  }

  .ask-ala-panel__title-wrap {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }

  .ask-ala-panel__avatar {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background-color: var(--accent);
    color: var(--ala-pure-white);
    font-weight: 800;
    font-size: var(--text-sm);
  }

  .ask-ala-panel__title-group {
    min-width: 0;
  }

  .ask-ala-panel__title {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--text);
    line-height: 1.3;
    margin: 0;
  }

  .ask-ala-panel__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    padding: 0;
    border: none;
    border-radius: 10px;
    background-color: transparent;
    color: var(--text-muted);
    cursor: pointer;
    transition: background-color 160ms var(--ease-out-expo), color 160ms var(--ease-out-expo);
  }

  .ask-ala-panel__close:hover {
    background-color: var(--surface);
    color: var(--text);
  }

  .ask-ala-panel__close:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .ask-ala-panel__body {
    flex: 1;
    overflow-y: auto;
    padding: 1.5rem 1.25rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    overscroll-behavior: contain;
  }

  .ask-ala-panel__messages {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .ask-ala-panel__message {
    max-width: 88%;
    padding: 0.875rem 1rem;
    border-radius: 16px;
    font-size: var(--text-md);
    line-height: 1.55;
  }

  .ask-ala-panel__message--assistant {
    align-self: flex-start;
    background-color: var(--surface);
    color: var(--text);
    border-bottom-left-radius: 6px;
  }

  .ask-ala-panel__message--user {
    align-self: flex-end;
    background-color: var(--accent);
    color: var(--ala-pure-white);
    border-bottom-right-radius: 6px;
  }

  .ask-ala-panel__message p {
    margin: 0;
  }

  .ask-ala-panel__message p + p,
  .ask-ala-panel__next {
    margin-top: 0.75rem;
  }

  .ask-ala-panel__recs {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0.75rem 0 0;
    padding: 0;
  }

  .ask-ala-panel__recs li {
    padding: 0.75rem 1rem;
    border-radius: 12px;
    background-color: var(--accent);
    color: var(--ala-pure-white);
    font-weight: 600;
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .ask-ala-panel__choices {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .ask-ala-panel__choice {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.625rem 1.125rem;
    border: 1.5px solid var(--line);
    border-radius: 9999px;
    background-color: var(--bg);
    color: var(--text);
    font-family: var(--ala-font);
    font-size: var(--text-sm);
    font-weight: 600;
    cursor: pointer;
    transition:
      border-color 160ms var(--ease-out-expo),
      background-color 160ms var(--ease-out-expo),
      color 160ms var(--ease-out-expo),
      box-shadow 160ms var(--ease-out-expo);
    -webkit-tap-highlight-color: transparent;
  }

  .ask-ala-panel__choice:hover {
    border-color: var(--accent);
    background-color: var(--accent);
    color: var(--ala-pure-white);
  }

  .ask-ala-panel__choice:active {
    transform: scale(0.97);
  }

  .ask-ala-panel__choice:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .ask-ala-panel__choice--secondary {
    border-color: transparent;
    background-color: transparent;
    color: var(--text-muted);
  }

  .ask-ala-panel__choice--secondary:hover {
    border-color: var(--line);
    background-color: var(--surface);
    color: var(--text);
  }

  .ask-ala-panel__typing {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 1rem 1.25rem;
    border-radius: 16px;
    border-bottom-left-radius: 6px;
    background-color: var(--surface);
    align-self: flex-start;
  }

  .ask-ala-panel__typing span {
    width: 7px;
    height: 7px;
    border-radius: 9999px;
    background-color: var(--text-muted);
    animation: typing-dot 1.4s ease-in-out infinite;
  }

  .ask-ala-panel__typing span:nth-child(2) {
    animation-delay: 0.15s;
  }

  .ask-ala-panel__typing span:nth-child(3) {
    animation-delay: 0.3s;
  }

  @keyframes typing-dot {
    0%, 100% { opacity: 0.3; transform: scale(0.8); }
    50% { opacity: 1; transform: scale(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .ask-ala-panel__typing span {
      animation: none;
    }
  }
</style>
