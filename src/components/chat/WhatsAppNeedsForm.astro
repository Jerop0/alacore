---
import { DEFAULT_LOCALE, WHATSAPP_NUMBER, type Locale } from '../../lib/config';
import type { CopyNode } from '../../lib/i18n';
import copy from '../../content/site-copy.json';

const currentLocale = Astro.currentLocale as Locale ?? DEFAULT_LOCALE;
const localeCopy = (copy as Record<string, CopyNode>)[currentLocale] ?? copy[DEFAULT_LOCALE];
const whatsapp = localeCopy.whatsapp as CopyNode;
const fields = (whatsapp.fields ?? {}) as Record<string, string>;
const placeholders = (whatsapp.placeholders ?? {}) as Record<string, string>;
---

<div
  class="whatsapp-panel"
  id="whatsapp-panel"
  role="dialog"
  aria-modal="true"
  aria-label={String(whatsapp.title ?? 'WhatsApp')}
  aria-hidden="true"
  data-copy={JSON.stringify(whatsapp)}
  data-locale={currentLocale}
  data-number={WHATSAPP_NUMBER}
>
  <div class="whatsapp-panel__backdrop" id="whatsapp-backdrop"></div>
  <div class="whatsapp-panel__sheet" id="whatsapp-sheet">
    <div class="whatsapp-panel__handle" aria-hidden="true"></div>
    <div class="whatsapp-panel__header">
      <div class="whatsapp-panel__title-wrap">
        <span class="whatsapp-panel__avatar" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
        </span>
        <div class="whatsapp-panel__title-group">
          <h2 class="whatsapp-panel__title">{String(whatsapp.title ?? 'WhatsApp')}</h2>
        </div>
      </div>
      <button type="button" class="whatsapp-panel__close" id="whatsapp-close" aria-label={String(whatsapp.close ?? 'Close')}>
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </div>
    <div class="whatsapp-panel__body" id="whatsapp-body"></div>
  </div>
</div>

<script>
  (function () {
    interface Copy {
      title?: string;
      close?: string;
      step: string;
      fields: Record<string, string>;
      placeholders: Record<string, string>;
      next: string;
      back: string;
      openWhatsApp: string;
      preface: string;
    }

    const panel = document.getElementById('whatsapp-panel');
    const body = document.getElementById('whatsapp-body');
    const closeBtn = document.getElementById('whatsapp-close');
    const backdrop = document.getElementById('whatsapp-backdrop');
    if (!panel || !body || !closeBtn || !backdrop) return;

    const raw = panel.dataset.copy;
    const number = panel.dataset.number ?? '4917621812212';
    const copy: Copy = raw ? JSON.parse(raw) : {} as Copy;

    const stepKeys = ['businessType', 'challenge', 'outcome', 'name', 'contactTime'];
    const answers: Record<string, string> = {};
    let step = 0;

    const setOpen = (open: boolean) => {
      panel.classList.toggle('is-open', open);
      panel.setAttribute('aria-hidden', String(!open));
      document.body.classList.toggle('no-scroll', open);
      if (open) {
        step = 0;
        stepKeys.forEach((k) => (answers[k] = ''));
        renderStep();
        setTimeout(() => {
          const first = body.querySelector<HTMLElement>('input, button');
          first?.focus();
        }, 0);
      } else {
        const opener = document.querySelector('.whatsapp-button') as HTMLElement | null;
        opener?.focus();
      }
    };

    const escapeHtml = (str: string) => {
      const div = document.createElement('div');
      div.textContent = str;
      return div.innerHTML;
    };

    const renderStep = () => {
      const key = stepKeys[step];
      const total = stepKeys.length;
      const stepText = copy.step.replace('{n}', String(step + 1)).replace('{total}', String(total));
      body.innerHTML = `
        <div class="request-modal__body">
          <p class="request-modal__step">${escapeHtml(stepText)}</p>
          <div class="request-modal__field">
            <label for="whatsapp-field-${key}" class="request-modal__label">${escapeHtml(copy.fields[key] ?? '')}</label>
            <input
              type="text"
              id="whatsapp-field-${key}"
              class="request-modal__input"
              placeholder="${escapeHtml(copy.placeholders[key] ?? '')}"
              value="${escapeHtml(answers[key] ?? '')}"
              autocomplete="off"
              aria-invalid="false"
            />
          </div>
          <div class="request-modal__actions">
            ${step > 0 ? `<button type="button" class="request-modal__button request-modal__button--secondary" data-action="back">${escapeHtml(copy.back)}</button>` : ''}
            <button type="button" class="request-modal__button request-modal__button--primary" data-action="next">${step < total - 1 ? escapeHtml(copy.next) : escapeHtml(copy.openWhatsApp)}</button>
          </div>
        </div>
      `;
      const input = body.querySelector<HTMLInputElement>(`#whatsapp-field-${key}`);
      input?.focus();
      body.querySelectorAll<HTMLButtonElement>('[data-action]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const action = btn.dataset.action;
          if (input) answers[key] = input.value.trim();
          if (action === 'back') {
            step--;
            renderStep();
          } else if (step < total - 1) {
            step++;
            renderStep();
          } else {
            openWhatsApp();
          }
        });
      });
    };

    const openWhatsApp = () => {
      const lines = [
        copy.preface,
        answers.businessType && `Business: ${answers.businessType}`,
        answers.challenge && `Challenge: ${answers.challenge}`,
        answers.outcome && `Goal: ${answers.outcome}`,
        answers.name && `Name: ${answers.name}`,
        answers.contactTime && `Best time: ${answers.contactTime}`,
      ].filter(Boolean);
      const text = encodeURIComponent(lines.join('\n'));
      window.open(`https://wa.me/${number}?text=${text}`, '_blank', 'noopener,noreferrer');
    };

    const openBtn = document.querySelector('.whatsapp-button');
    openBtn?.addEventListener('click', () => setOpen(true));

    closeBtn.addEventListener('click', () => setOpen(false));
    backdrop.addEventListener('click', () => setOpen(false));

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && panel.classList.contains('is-open')) {
        setOpen(false);
      }
    });
  })();
</script>

<style>
  .whatsapp-panel {
    position: fixed;
    inset: 0;
    z-index: var(--z-panel);
    display: none;
  }

  .whatsapp-panel.is-open {
    display: block;
  }

  .whatsapp-panel__backdrop {
    position: absolute;
    inset: 0;
    background-color: rgba(11, 18, 32, 0.45);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    opacity: 0;
    transition: opacity 280ms var(--ease-out-expo);
  }

  .whatsapp-panel.is-open .whatsapp-panel__backdrop {
    opacity: 1;
  }

  .whatsapp-panel__sheet {
    position: absolute;
    right: 1.5rem;
    bottom: 1.5rem;
    width: min(560px, calc(100vw - 32px));
    max-height: min(720px, calc(100vh - 32px));
    display: flex;
    flex-direction: column;
    border-radius: 22px;
    background: #fff;
    box-shadow: 0 24px 80px rgba(15, 23, 42, 0.28);
    transform: translateY(16px) scale(0.97);
    opacity: 0;
    transition:
      transform 280ms var(--ease-out-expo),
      opacity 280ms var(--ease-out-expo);
    overflow: hidden;
  }

  [data-theme='dark'] .whatsapp-panel__sheet {
    background: #0f172a;
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.5);
  }

  .whatsapp-panel.is-open .whatsapp-panel__sheet {
    transform: translateY(0) scale(1);
    opacity: 1;
  }

  .whatsapp-panel__handle {
    display: none;
    width: 36px;
    height: 4px;
    margin: 0.625rem auto 0;
    border-radius: 999px;
    background-color: var(--line);
  }

  @media (max-width: 640px) {
    .whatsapp-panel__sheet {
      right: 0;
      bottom: 0;
      width: 100%;
      max-height: 92vh;
      padding-bottom: env(safe-area-inset-bottom);
      border-radius: 22px 22px 0 0;
      transform: translateY(100%);
    }

    .whatsapp-panel.is-open .whatsapp-panel__sheet {
      transform: translateY(0);
    }

    .whatsapp-panel__handle {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .whatsapp-panel__backdrop,
    .whatsapp-panel__sheet {
      transition: none;
    }
  }

  .whatsapp-panel__header {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 24px 26px 20px;
    border-bottom: 1px solid rgba(15, 23, 42, 0.1);
  }

  [data-theme='dark'] .whatsapp-panel__header {
    border-bottom-color: rgba(255, 255, 255, 0.1);
  }

  .whatsapp-panel__title-wrap {
    display: flex;
    align-items: center;
    gap: 16px;
    min-width: 0;
    flex: 1;
  }

  .whatsapp-panel__avatar {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background-color: rgba(18, 183, 106, 0.1);
    color: var(--ala-success);
  }

  [data-theme='dark'] .whatsapp-panel__avatar {
    background-color: rgba(18, 183, 106, 0.15);
    color: #34d399;
  }

  .whatsapp-panel__title-group {
    min-width: 0;
  }

  .whatsapp-panel__title {
    font-size: 22px;
    line-height: 1.25;
    font-weight: 800;
    color: #07111f;
    margin: 0;
  }

  [data-theme='dark'] .whatsapp-panel__title {
    color: #f1f5f9;
  }

  .whatsapp-panel__close {
    margin-inline-start: auto;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: #64748b;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
    transition: background-color 160ms var(--ease-out-expo), color 160ms var(--ease-out-expo);
  }

  .whatsapp-panel__close:hover {
    background-color: rgba(15, 23, 42, 0.05);
    color: #07111f;
  }

  [data-theme='dark'] .whatsapp-panel__close:hover {
    background-color: rgba(255, 255, 255, 0.1);
    color: #f1f5f9;
  }

  .whatsapp-panel__close:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .whatsapp-panel__body {
    flex: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  :global(.request-modal__body) {
    padding: 28px 26px 26px;
  }

  :global(.request-modal__step) {
    margin: 0 0 16px;
    font-size: 15px;
    font-weight: 700;
    color: #1768ff;
  }

  :global(.request-modal__field) {
    display: grid;
    gap: 10px;
  }

  :global(.request-modal__label) {
    display: block;
    font-size: 18px;
    line-height: 1.45;
    font-weight: 700;
    color: #07111f;
  }

  :global([data-theme='dark'] .request-modal__label) {
    color: #f1f5f9;
  }

  :global(.request-modal__input) {
    display: block;
    width: 100%;
    height: 52px;
    box-sizing: border-box;
    border-radius: 12px;
    border: 1px solid rgba(15, 23, 42, 0.18);
    background: #f8fafc;
    padding: 0 16px;
    font-size: 16px;
    color: #07111f;
    outline: none;
    font-family: var(--ala-font);
    transition: border-color 180ms var(--ease-out-expo), background-color 180ms var(--ease-out-expo), box-shadow 180ms var(--ease-out-expo);
    -webkit-appearance: none;
    appearance: none;
  }

  :global([data-theme='dark'] .request-modal__input) {
    background: #1e293b;
    border-color: rgba(255, 255, 255, 0.18);
    color: #f1f5f9;
  }

  :global(.request-modal__input::placeholder) {
    color: #64748b;
  }

  :global([data-theme='dark'] .request-modal__input::placeholder) {
    color: #94a3b8;
  }

  :global(.request-modal__input:focus) {
    border-color: #1768ff;
    background: #fff;
    box-shadow: 0 0 0 4px rgba(23, 104, 255, 0.14);
  }

  :global([data-theme='dark'] .request-modal__input:focus) {
    background: #0f172a;
  }

  :global(.request-modal__input[aria-invalid='true']) {
    border-color: #ef4444;
  }

  :global(.request-modal__input[aria-invalid='true']:focus) {
    box-shadow: 0 0 0 4px rgba(239, 68, 68, 0.14);
  }

  :global(.request-modal__actions) {
    display: flex;
    justify-content: flex-end;
    gap: 12px;
    margin-top: 22px;
  }

  :global(.request-modal__button) {
    min-height: 48px;
    padding: 0 24px;
    border-radius: 12px;
    border: 0;
    font-size: 16px;
    font-weight: 800;
    cursor: pointer;
    font-family: var(--ala-font);
    transition: background-color 160ms var(--ease-out-expo), transform 120ms var(--ease-out-expo);
    -webkit-tap-highlight-color: transparent;
  }

  :global(.request-modal__button:active) {
    transform: scale(0.98);
  }

  :global(.request-modal__button:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  :global(.request-modal__button--primary) {
    background: #1768ff;
    color: #fff;
  }

  :global(.request-modal__button--primary:hover) {
    background: #0f58df;
  }

  :global(.request-modal__button--secondary) {
    background: transparent;
    color: #64748b;
    padding: 0 16px;
  }

  :global(.request-modal__button--secondary:hover) {
    background: rgba(15, 23, 42, 0.05);
    color: #07111f;
  }

  :global([data-theme='dark'] .request-modal__button--secondary:hover) {
    background: rgba(255, 255, 255, 0.1);
    color: #f1f5f9;
  }

  @media (max-width: 640px) {
    :global(.request-modal__body) {
      padding: 22px 18px 20px;
    }

    :global(.request-modal__actions) {
      flex-direction: column-reverse;
    }

    :global(.request-modal__button) {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.request-modal__button),
    :global(.request-modal__input) {
      transition: none;
    }
  }
</style>
