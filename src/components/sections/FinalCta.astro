---
import Button from '../ui/Button.astro';
import CoreOrbit from './CoreOrbit.astro';
import { DEFAULT_LOCALE, type Locale } from '../../lib/config';
import { localizePath, t } from '../../lib/i18n';
import type { CopyNode } from '../../lib/i18n';

interface Props {
  locale: Locale;
  copy: CopyNode;
}

const { locale, copy } = Astro.props;
---

<section class="final-cta">
  <div class="container final-cta__inner">
    <div class="final-cta__content" data-animate="scale-up">
      <h2 class="final-cta__title">{t(copy, 'finalCta')}</h2>
      <div class="final-cta__actions" data-animate="fade-up" style="--delay: 200ms">
        <Button href={localizePath('/contact', locale, locale)}>
          {t(copy, 'hero.secondary')}
        </Button>
        <Button
          variant="secondary"
          onDark
          id="final-cta-ask-ala"
        >
          {t(copy, 'finalCtaSecondary')}
        </Button>
      </div>
    </div>
    <div class="final-cta__visual" aria-hidden="true" data-animate="fade-up" style="--delay: 300ms">
      <CoreOrbit compact />
    </div>
  </div>

  <script>
    (function () {
      const btn = document.getElementById('final-cta-ask-ala');
      if (!btn) return;
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        window.dispatchEvent(new CustomEvent('open-ask-ala'));
      });
    })();
  </script>
</section>

<style>
  .final-cta {
    position: relative;
    overflow: hidden;
    padding: 72px 0 56px;
    background-color: var(--ala-core-ink);
    color: var(--ala-pure-white);
  }

  @media (max-width: 767px) {
    .final-cta {
      padding: 52px 0 40px;
    }
  }

  .final-cta__inner {
    position: relative;
    display: grid;
    gap: 32px;
    align-items: center;
    z-index: 1;
  }

  @media (min-width: 1024px) {
    .final-cta__inner {
      grid-template-columns: 1fr auto;
    }
  }

  .final-cta__content {
    position: relative;
    z-index: 1;
  }

  .final-cta__title {
    font-size: clamp(36px, 5vw, 64px);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    max-width: 720px;
    margin: 0 0 24px 0;
  }

  .final-cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .final-cta__visual {
    position: absolute;
    inset-inline-end: -5%;
    top: 50%;
    transform: translateY(-50%);
    width: min(420px, 45vw);
    opacity: 0.08;
    pointer-events: none;
    z-index: 0;
  }

  @media (max-width: 1023px) {
    .final-cta__visual {
      display: none;
    }
  }
</style>
