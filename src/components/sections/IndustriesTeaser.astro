---
import SectionHeading from '../ui/SectionHeading.astro';
import Icon from '../ui/Icon.astro';
import { INDUSTRIES, DEFAULT_LOCALE, type Locale } from '../../lib/config';
import { localizePath, t } from '../../lib/i18n';
import type { CopyNode } from '../../lib/i18n';

interface Props {
  locale: Locale;
  copy: CopyNode;
}

const { locale, copy } = Astro.props;

const industryLabels: Record<string, string> = {
  'restaurants-cafes': 'Restaurants & Cafes',
  'hospitals-clinics': 'Hospitals & Clinics',
  'schools-training': 'Schools & Training',
  'companies-offices': 'Companies & Offices',
  'warehouses-logistics': 'Warehouses & Logistics',
  'retail-ecommerce': 'Retail & E-commerce',
  'factories-manufacturing': 'Factories & Manufacturing',
};
---

<section class="section section--mist">
  <div class="container">
    <SectionHeading
      title={t(copy, 'sections.industries')}
      supporting={t(copy, 'sections.industriesSupport')}
    />

    <div class="industries-teaser">
      <ul class="industries-teaser__list" role="tablist" aria-label="Industries">
        {
          INDUSTRIES.map((industry) => (
            <li class="industries-teaser__item">
              <a
                href={localizePath(`/industries/${industry.slug}`, locale, locale)}
                class="industries-teaser__card"
              >
                <span class="industries-teaser__icon">
                  <Icon name={industry.iconKey.toLowerCase()} size={22} />
                </span>
                <span class="industries-teaser__label">{industryLabels[industry.slug]}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="industries-teaser__footer">
      <a href={localizePath('/industries', locale, locale)} class="industries-teaser__all">
        {t(copy, 'sections.industries')}
        <Icon name="arrow-right" size={16} />
      </a>
    </div>
  </div>
</section>

<style>
  .industries-teaser {
    overflow-x: auto;
    padding-bottom: 0.5rem;
    -webkit-overflow-scrolling: touch;
  }

  .industries-teaser__list {
    display: flex;
    gap: 0.75rem;
    min-width: max-content;
    list-style: none;
  }

  @media (min-width: 1024px) {
    .industries-teaser__list {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      min-width: auto;
    }
  }

  .industries-teaser__card {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    min-width: 140px;
    padding: 1.25rem 1rem;
    border: 1px solid var(--line);
    border-radius: var(--ala-radius-md);
    background-color: var(--bg);
    color: var(--text);
    text-align: center;
    transition: border-color 180ms var(--ease-out-expo), transform 180ms var(--ease-out-expo);
  }

  .industries-teaser__card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .industries-teaser__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background-color: var(--accent-tint);
    color: var(--accent);
  }

  .industries-teaser__label {
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .industries-teaser__footer {
    margin-top: 2rem;
    text-align: center;
  }

  .industries-teaser__all {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    color: var(--accent);
  }

  .industries-teaser__all:hover {
    color: var(--accent-hover);
  }
</style>
