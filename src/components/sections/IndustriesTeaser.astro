---
import SectionHeading from '../ui/SectionHeading.astro';
import Icon from '../ui/Icon.astro';
import { INDUSTRIES, DEFAULT_LOCALE, type Locale } from '../../lib/config';
import { localizePath, t } from '../../lib/i18n';
import type { CopyNode } from '../../lib/i18n';

interface Props {
  locale: Locale;
  copy: CopyNode;
}

const { locale, copy } = Astro.props;

const industryLabels: Record<string, string> = {
  'restaurants-cafes': 'Restaurants & Cafes',
  'hospitals-clinics': 'Hospitals & Clinics',
  'schools-training': 'Schools & Training',
  'companies-offices': 'Companies & Offices',
  'warehouses-logistics': 'Warehouses & Logistics',
  'retail-ecommerce': 'Retail & E-commerce',
  'factories-manufacturing': 'Factories & Manufacturing',
};

const industryImages: Record<string, string> = {
  'factories-manufacturing': '/images/industries/factories-manufacturing-germany.png',
  'retail-ecommerce': '/images/industries/retail-ecommerce-germany.png',
  'warehouses-logistics': '/images/industries/warehouses-logistics-germany.png',
  'companies-offices': '/images/industries/companies-offices-germany.png',
  'schools-training': '/images/industries/schools-training-germany.png',
  'hospitals-clinics': '/images/industries/hospitals-clinics-germany.png',
  'restaurants-cafes': '/images/industries/restaurants-cafes-germany.png',
};
---

<section class="section section--mist">
  <div class="container">
    <SectionHeading
      title={t(copy, 'sections.industries')}
      supporting={t(copy, 'sections.industriesSupport')}
    />

    <div class="industries-teaser">
      <ul class="industries-teaser__list" role="tablist" aria-label="Industries">
        {
          INDUSTRIES.map((industry) => (
            <li class="industries-teaser__item">
              <a
                href={localizePath(`/industries/${industry.slug}`, locale, locale)}
                class="industries-teaser__card"
              >
                <div class="industries-teaser__image-wrapper">
                  <img
                    src={industryImages[industry.slug]}
                    alt={industryLabels[industry.slug]}
                    class="industries-teaser__image"
                    width="400"
                    height="300"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <span class="industries-teaser__label">{industryLabels[industry.slug]}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="industries-teaser__footer">
      <a href={localizePath('/industries', locale, locale)} class="industries-teaser__all">
        {t(copy, 'sections.industries')}
        <Icon name="arrow-right" size={16} />
      </a>
    </div>
  </div>
</section>

<style>
  .industries-teaser {
    margin-top: 2rem;
  }

  .industries-teaser__list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .industries-teaser__card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: var(--ala-radius-md);
    background-color: var(--bg);
    color: var(--text);
    text-decoration: none;
    overflow: hidden;
    transition: border-color 180ms var(--ease-out-expo), transform 180ms var(--ease-out-expo), box-shadow 180ms var(--ease-out-expo);
  }

  .industries-teaser__card:hover {
    border-color: var(--accent);
    transform: translateY(-4px);
    box-shadow: 0 12px 24px -12px rgba(0, 0, 0, 0.15);
  }

  .industries-teaser__image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background-color: var(--surface);
  }

  .industries-teaser__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 300ms var(--ease-out-expo);
  }

  .industries-teaser__card:hover .industries-teaser__image {
    transform: scale(1.05);
  }

  .industries-teaser__label {
    display: block;
    padding: 1.25rem;
    font-size: var(--text-md);
    font-weight: 700;
    text-align: center;
  }

  .industries-teaser__footer {
    margin-top: 2.5rem;
    text-align: center;
  }

  .industries-teaser__all {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    color: var(--accent);
  }

  .industries-teaser__all:hover {
    color: var(--accent-hover);
  }

  @media (prefers-reduced-motion: reduce) {
    .industries-teaser__image,
    .industries-teaser__card {
      transition: none;
    }

    .industries-teaser__card:hover .industries-teaser__image {
      transform: none;
    }

    .industries-teaser__card:hover {
      transform: none;
    }
  }
</style>
