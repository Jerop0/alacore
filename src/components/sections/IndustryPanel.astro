---
import SectionHeading from '../ui/SectionHeading.astro';
import IndustryCatalog from '../sections/IndustryCatalog.astro';
import Button from '../ui/Button.astro';
import { type Locale } from '../../lib/config';
import { localizePath, t, tObj } from '../../lib/i18n';
import type { CopyNode } from '../../lib/i18n';
import catalogData from '../../content/industries-catalog.json';

interface Props {
  locale: Locale;
  copy: CopyNode;
  siteCopy: CopyNode;
  slug: string;
}

const { locale, copy, siteCopy, slug } = Astro.props;
const list = tObj<Record<string, CopyNode>>(copy, 'list') ?? {};
const item = list[slug] ?? {};
const catalogLocale = (catalogData as Record<string, any>)[locale] ?? (catalogData as Record<string, any>)['en'];
const catalog = catalogLocale.catalog?.[slug];

const industryImages: Record<string, string> = {
  'factories-manufacturing': '/images/industries/factories-manufacturing-germany.png',
  'retail-ecommerce': '/images/industries/retail-ecommerce-germany.png',
  'warehouses-logistics': '/images/industries/warehouses-logistics-germany.png',
  'companies-offices': '/images/industries/companies-offices-germany.png',
  'schools-training': '/images/industries/schools-training-germany.png',
  'hospitals-clinics': '/images/industries/hospitals-clinics-germany.png',
  'restaurants-cafes': '/images/industries/restaurants-cafes-germany.png',
};

const heroImage = industryImages[slug];
---

<section class="section industry-panel">
  <div class="container">
    {heroImage && (
      <div class="industry-panel__hero">
        <img
          src={heroImage}
          alt={t(item, 'name')}
          class="industry-panel__hero-image"
          width="1200"
          height="675"
          loading="lazy"
          decoding="async"
        />
      </div>
    )}
    <SectionHeading title={t(item, 'name')} supporting={t(item, 'oneLiner')} />

    {
      catalog ? (
        <IndustryCatalog
          intro={catalog.intro}
          themes={catalog.themes ?? []}
          bundle={catalog.bundle}
          cta={catalog.cta}
          locale={locale}
        />
      ) : (
        <div class="industry-panel__fallback">
          <p>{t(item, 'businessType')}</p>
          <div class="industry-panel__actions">
            <Button href={localizePath('/contact', locale, locale)}>{t(copy, 'cta')}</Button>
            <Button variant="ghost" id="industry-ask-ala">{t(siteCopy, 'finalCtaSecondary')}</Button>
          </div>
        </div>
      )
    }
  </div>
</section>

<script>
  (function () {
    const btn = document.getElementById('industry-ask-ala');
    if (!btn) return;
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      window.dispatchEvent(new CustomEvent('open-ask-ala'));
    });
  })();
</script>

<style>
  .industry-panel {
    padding-top: 120px;
  }

  .industry-panel__hero {
    margin-bottom: 3rem;
    border-radius: var(--ala-radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }

  .industry-panel__hero-image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    transition: transform 400ms var(--ease-out-expo);
  }

  .industry-panel__hero:hover .industry-panel__hero-image {
    transform: scale(1.02);
  }

  @media (prefers-reduced-motion: reduce) {
    .industry-panel__hero-image {
      transition: none;
    }

    .industry-panel__hero:hover .industry-panel__hero-image {
      transform: none;
    }
  }

  .industry-panel__fallback {
    max-width: 800px;
    margin-inline: auto;
    padding: 2rem;
    border: 1px solid var(--line);
    border-radius: var(--ala-radius-md);
    background-color: var(--bg);
    box-shadow: var(--shadow-card);
  }

  .industry-panel__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }
</style>
