---
import Pill from '../ui/Pill.astro';

interface Item {
  name: string;
  benefit: string;
  howItWorks?: string[];
}

interface Props {
  title: string;
  summary: string;
  pills?: string[];
  items?: Item[];
  dialog?: {
    triggerLabel: string;
    title: string;
    body: string;
  };
}

const { title, summary, pills = [], items = [], dialog } = Astro.props;
const hasDialog = Boolean(dialog);
const dialogId = hasDialog ? `dialog-${Math.random().toString(36).slice(2, 9)}` : undefined;
const hasExpand = items.length > 0;
---

<article class="rich-row" data-has-expand={hasExpand ? 'true' : undefined} data-has-dialog={hasDialog ? 'true' : undefined}>
  {
    hasExpand ? (
      <details class="rich-row__disclosure">
        <summary class="rich-row__header">
          <div class="rich-row__heading">
            <h3 class="rich-row__title">{title}</h3>
            <p class="rich-row__summary">{summary}</p>
            {
              pills.length > 0 && (
                <div class="rich-row__pills">
                  {pills.map((pill) => (
                    <Pill>{pill}</Pill>
                  ))}
                </div>
              )
            }
          </div>
          <span class="rich-row__chevron" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m6 9 6 6 6-6" />
            </svg>
          </span>
        </summary>
        <div class="rich-row__body">
          {
            items.length > 0 && (
              <ul class="rich-row__items">
                {items.map((item) => (
                  <li class="rich-row__item">
                    <div class="rich-row__item-main">
                      <strong class="rich-row__item-name">{item.name}</strong>
                      <span class="rich-row__item-benefit">{item.benefit}</span>
                    </div>
                    {item.howItWorks && item.howItWorks.length > 0 && (
                      <div class="rich-row__how">
                        <span class="rich-row__how-label">How it works:</span>
                        <ol class="rich-row__how-steps">
                          {item.howItWorks.map((step) => (
                            <li>{step}</li>
                          ))}
                        </ol>
                      </div>
                    )}
                  </li>
                ))}
              </ul>
            )
          }
        </div>
      </details>
    ) : (
      <div class="rich-row__header rich-row__header--static">
        <div class="rich-row__heading">
          <h3 class="rich-row__title">{title}</h3>
          <p class="rich-row__summary">{summary}</p>
          {
            pills.length > 0 && (
              <div class="rich-row__pills">
                {pills.map((pill) => (
                  <Pill>{pill}</Pill>
                ))}
              </div>
            )
          }
        </div>
        {
          dialog && dialogId && (
            <button type="button" class="rich-row__dialog-btn" data-open-dialog={dialogId} aria-haspopup="dialog">
              {dialog.triggerLabel}
            </button>
          )
        }
      </div>
    )
  }

  {
    dialog && dialogId && (
      <dialog class="rich-row__dialog" id={dialogId} aria-labelledby={`${dialogId}-title`}>
        <div class="rich-row__dialog-backdrop" data-close-dialog></div>
        <div class="rich-row__dialog-sheet">
          <div class="rich-row__dialog-handle" aria-hidden="true"></div>
          <div class="rich-row__dialog-header">
            <h2 id={`${dialogId}-title`} class="rich-row__dialog-title">{dialog.title}</h2>
            <button type="button" class="rich-row__dialog-close" data-close-dialog aria-label="Close">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
            </button>
          </div>
          <div class="rich-row__dialog-body">
            <slot name="dialog">
              <p>{dialog.body}</p>
            </slot>
          </div>
        </div>
      </dialog>
    )
  }
</article>

<script>
  (function () {
    // Dialog handling for rows with dialog buttons
    const rowsWithDialog = document.querySelectorAll('.rich-row[data-has-dialog="true"]');
    rowsWithDialog.forEach((row) => {
      const openBtn = row.querySelector<HTMLButtonElement>('[data-open-dialog]');
      const dialog = row.querySelector<HTMLDialogElement>('.rich-row__dialog');
      if (!openBtn || !dialog) return;

      const closeBtns = dialog.querySelectorAll<HTMLButtonElement>('[data-close-dialog]');

      const trapFocus = (e: KeyboardEvent) => {
        if (e.key !== 'Tab') return;
        const focusables = dialog.querySelectorAll<HTMLElement>('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])');
        if (focusables.length === 0) return;
        const first = focusables[0];
        const last = focusables[focusables.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      };

      const onKeyDown = (e: KeyboardEvent) => {
        if (e.key === 'Escape') {
          dialog.close();
        } else {
          trapFocus(e);
        }
      };

      openBtn.addEventListener('click', () => {
        dialog.showModal();
        const firstFocusable = dialog.querySelector<HTMLElement>('button, [href], input, select, textarea');
        firstFocusable?.focus();
        dialog.addEventListener('keydown', onKeyDown);
      });

      const close = () => {
        dialog.close();
        dialog.removeEventListener('keydown', onKeyDown);
        openBtn.focus();
      };

      closeBtns.forEach((btn) => {
        btn.addEventListener('click', (e) => {
          if (e.target === btn) close();
        });
      });

      dialog.addEventListener('click', (e) => {
        const rect = dialog.getBoundingClientRect();
        if (
          e.clientX < rect.left ||
          e.clientX > rect.right ||
          e.clientY < rect.top ||
          e.clientY > rect.bottom
        ) {
          close();
        }
      });

      dialog.addEventListener('close', () => {
        dialog.removeEventListener('keydown', onKeyDown);
        openBtn.focus();
      });
    });

    // Hover/focus reveal for expandable rows on pointer devices
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isCoarse = window.matchMedia('(pointer: coarse)').matches;

    if (!isCoarse && !prefersReducedMotion) {
      document.querySelectorAll('.rich-row[data-has-expand="true"]').forEach((row) => {
        const details = row.querySelector<HTMLDetailsElement>('.rich-row__disclosure');
        if (!details) return;

        let clickPinned = false;

        const open = () => {
          details.open = true;
        };

        const closeIfNotPinned = () => {
          if (!clickPinned) {
            details.open = false;
          }
        };

        row.addEventListener('mouseenter', open);
        row.addEventListener('mouseleave', closeIfNotPinned);

        details.addEventListener('toggle', () => {
          clickPinned = details.open;
        });

        details.addEventListener('click', (e) => {
          const summary = details.querySelector('.rich-row__header');
          if (summary && summary.contains(e.target as Node)) {
            clickPinned = !details.open;
          }
        });
      });
    }
  })();
</script>

<style>
  .rich-row {
    border: 1px solid var(--line);
    border-radius: var(--ala-radius-md);
    background-color: var(--bg);
    box-shadow: var(--shadow-card);
    transition: border-color 180ms var(--ease-out-expo), transform 180ms var(--ease-out-expo);
  }

  .rich-row:hover,
  .rich-row:focus-within {
    border-color: var(--accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .rich-row:hover {
      transform: translateY(-2px);
    }
  }

  .rich-row__disclosure {
    display: block;
    width: 100%;
  }

  .rich-row__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    width: 100%;
    padding: 1.5rem;
    list-style: none;
    cursor: pointer;
  }

  .rich-row__header::-webkit-details-marker {
    display: none;
  }

  .rich-row__header--static {
    cursor: default;
  }

  .rich-row__heading {
    flex: 1;
    min-width: 0;
  }

  .rich-row__title {
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--text);
    margin-bottom: 0.5rem;
  }

  .rich-row__summary {
    font-size: var(--text-md);
    line-height: 1.6;
    color: var(--text-muted);
    max-width: 72ch;
  }

  .rich-row__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .rich-row__chevron {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    border: 1px solid var(--line);
    border-radius: var(--ala-radius-sm);
    color: var(--text-muted);
    transition: transform 160ms var(--ease-out-expo), border-color 160ms var(--ease-out-expo), color 160ms var(--ease-out-expo);
  }

  .rich-row__disclosure[open] .rich-row__chevron {
    transform: rotate(180deg);
  }

  .rich-row__header:hover .rich-row__chevron,
  .rich-row__header:focus .rich-row__chevron {
    border-color: var(--accent);
    color: var(--accent);
  }

  .rich-row__body {
    display: block;
    width: 100%;
    padding: 0 1.5rem 1.5rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .rich-row__items {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .rich-row__item {
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: var(--ala-radius-sm);
    background-color: var(--surface);
  }

  .rich-row__item-main {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  @media (min-width: 768px) {
    .rich-row__item-main {
      flex-direction: row;
      align-items: baseline;
      gap: 0.75rem;
    }
  }

  .rich-row__item-name {
    color: var(--text);
    font-weight: 700;
    font-size: var(--text-md);
  }

  .rich-row__item-benefit {
    color: var(--text-muted);
    font-size: var(--text-md);
  }

  .rich-row__how {
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--line);
  }

  .rich-row__how-label {
    display: block;
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--text);
    margin-bottom: 0.375rem;
  }

  .rich-row__how-steps {
    list-style: decimal;
    padding-left: 1.25rem;
    margin: 0;
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: 1.7;
  }

  .rich-row__dialog-btn {
    min-height: 44px;
    padding: 0 1rem;
    border: 1px solid var(--accent);
    border-radius: var(--ala-radius-sm);
    background-color: transparent;
    color: var(--accent);
    font-family: var(--ala-font);
    font-size: var(--text-sm);
    font-weight: 700;
    cursor: pointer;
  }

  .rich-row__dialog-btn:hover {
    background-color: var(--accent-tint);
  }

  .rich-row__dialog {
    position: fixed;
    inset: 0;
    z-index: var(--z-panel);
    max-width: 100%;
    max-height: 100%;
    width: 100%;
    height: 100%;
    padding: 0;
    border: none;
    background: transparent;
  }

  .rich-row__dialog::backdrop {
    background-color: rgba(11, 18, 32, 0.5);
    opacity: 0;
    transition: opacity 220ms var(--ease-out-expo);
  }

  .rich-row__dialog[open]::backdrop {
    opacity: 1;
  }

  .rich-row__dialog-backdrop {
    position: absolute;
    inset: 0;
  }

  .rich-row__dialog-sheet {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    width: min(calc(100% - 2rem), 560px);
    max-height: calc(100vh - 2rem);
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: var(--ala-radius-lg);
    background-color: var(--bg);
    box-shadow: var(--shadow-card);
  }

  .rich-row__dialog-handle {
    display: none;
    width: 40px;
    height: 4px;
    margin: 0.75rem auto 0;
    border-radius: 999px;
    background-color: var(--line);
  }

  @media (max-width: 640px) {
    .rich-row__dialog-sheet {
      right: 0;
      bottom: 0;
      width: 100%;
      max-height: 85vh;
      padding-bottom: env(safe-area-inset-bottom);
      border-radius: var(--ala-radius-lg) var(--ala-radius-lg) 0 0;
    }

    .rich-row__dialog-handle {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rich-row__dialog::backdrop {
      transition: none;
    }
  }

  .rich-row__dialog-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--line);
  }

  .rich-row__dialog-title {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--text);
  }

  .rich-row__dialog-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: none;
    border-radius: var(--ala-radius-sm);
    background-color: transparent;
    color: var(--text-muted);
    cursor: pointer;
  }

  .rich-row__dialog-close:hover {
    background-color: var(--surface);
    color: var(--text);
  }

  .rich-row__dialog-body {
    flex: 1;
    overflow-y: auto;
    padding: 1.25rem;
    color: var(--text-muted);
    line-height: 1.6;
  }
</style>
