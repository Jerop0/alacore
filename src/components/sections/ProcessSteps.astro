---
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';
import type { CopyNode } from '../../lib/i18n';
import type { Locale } from '../../lib/config';
import { localizePath, t, tArr } from '../../lib/i18n';

interface Props {
  copy: CopyNode;
  locale: Locale;
}

const { copy, locale } = Astro.props;
const steps = tArr(copy, 'process');

const stepImages = [
  '/how-we-work/understand.png',
  '/how-we-work/design.png',
  '/how-we-work/build.png',
  '/how-we-work/support.png',
];
---

<section class="section section--mist">
  <div class="container">
    <div data-animate="fade-down">
      <SectionHeading
        title={t(copy, 'sections.process')}
        supporting={t(copy, 'sections.processSupport')}
      />
    </div>

    <ol class="process-steps">
      {
        steps.map((step, index) => {
          const animations = ['fade-left', 'fade-down', 'fade-up', 'fade-right'];
          const animation = animations[index % animations.length];
          return (
            <li class="process-step" data-animate={animation} style={`--delay: ${index * 90}ms`}>
              <div class="process-step__media">
                <img
                  src={stepImages[index]}
                  alt={step}
                  width="400"
                  height="210"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="process-step__content">
                <span class="process-step__number">0{index + 1}</span>
                <h3 class="process-step__title">{step}</h3>
              </div>
            </li>
          );
        })
      }
    </ol>

    <p class="process-body" data-animate="fade-up" style="--delay: 360ms">{t(copy, 'processBody')}</p>

    <div class="process-cta" data-animate="fade-up" style="--delay: 450ms">
      <Button href={localizePath('/about', locale, locale)} variant="secondary">
        {t(copy, 'sections.processCta')}
      </Button>
    </div>
  </div>
</section>

<style>
  .process-steps {
    display: grid;
    gap: 1rem;
    list-style: none;
  }

  @media (min-width: 768px) {
    .process-steps {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .process-step {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: 18px;
    background-color: var(--bg);
    border: 1px solid rgba(15, 23, 42, 0.1);
    box-shadow: 0 12px 34px rgba(15, 23, 42, 0.06);
  }

  .process-step__media {
    width: 100%;
    height: 210px;
    overflow: hidden;
  }

  .process-step__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .process-step__content {
    padding: 26px 28px 30px;
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .process-step:not(:last-child)::after {
      content: '';
      position: absolute;
      top: 50%;
      right: -0.75rem;
      width: 1.5rem;
      height: 1px;
      background-color: var(--line);
    }
  }

  @media (min-width: 1024px) {
    .process-step:not(:last-child)::after {
      content: '';
      position: absolute;
      top: 50%;
      right: -1rem;
      width: 2rem;
      height: 1px;
      background-color: var(--line);
    }
  }

  .process-step__number {
    display: block;
    margin-bottom: 0.5rem;
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--accent);
  }

  .process-step__title {
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--text);
  }

  .process-body {
    max-width: 680px;
    margin-top: 2rem;
    font-size: var(--text-xl);
    line-height: 1.55;
    color: var(--text-muted);
  }

  .process-cta {
    margin-top: 2rem;
  }
</style>
