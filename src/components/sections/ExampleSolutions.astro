---
import SectionHeading from '../ui/SectionHeading.astro';
import Pill from '../ui/Pill.astro';
import type { CopyNode } from '../../lib/i18n';
import { t, tArr, tObj } from '../../lib/i18n';

interface Props {
  copy: CopyNode;
}

const { copy } = Astro.props;

const examples = ['restaurant', 'hospital', 'school', 'warehouse', 'company'] as const;

const media: Record<(typeof examples)[number], { src: string; alt: string }> = {
  restaurant: {
    src: '/images/industries/restaurant-digital-operations.png',
    alt: 'Restaurant staff managing digital orders and takeaway preparation',
  },
  hospital: {
    src: '/images/industries/hospital-patient-management.png',
    alt: 'Clinic staff managing appointments and assisting a patient',
  },
  school: {
    src: '/images/industries/school-administration-system.png',
    alt: 'School administrator helping a student and parent using a digital portal',
  },
  warehouse: {
    src: '/images/industries/warehouse-inventory-logistics.png',
    alt: 'Warehouse team scanning inventory and preparing shipments',
  },
  company: {
    src: '/images/industries/company-business-platform.png',
    alt: 'Business team reviewing customer workflows and company dashboards',
  },
};
---

<section class="section">
  <div class="container">
    <div data-animate="fade-up">
      <SectionHeading
        title={t(copy, 'sections.examples')}
        supporting={t(copy, 'sections.examplesSupport')}
      />
    </div>

    <div class="examples-grid">
      {
        examples.map((key, index) => {
          const item = tObj<CopyNode>(copy, `examples.${key}`);
          if (!item) return null;
          const title = t(item, 'title');
          const situation = t(item, 'situation');
          const pills = tArr(item, 'pills');
          const outcome = t(item, 'outcome');
          const image = media[key];
          return (
            <article class="example-card" data-animate="fade-up" style={`--delay: ${index * 80}ms`}>
              <div class="example-card__media">
                <img
                  src={image.src}
                  alt={image.alt}
                  width="800"
                  height="600"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="example-card__content">
                <h3 class="example-card__title">{title}</h3>
                <p class="example-card__situation">{situation}</p>
                <div class="example-card__pills">
                  {pills.map((pill) => (
                    <Pill>{pill}</Pill>
                  ))}
                </div>
                <p class="example-card__outcome">{outcome}</p>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .examples-grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 768px) {
    .examples-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .examples-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .example-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--ala-radius-md);
    background-color: var(--surface);
  }

  .example-card:first-child {
    grid-column: 1 / -1;
  }

  @media (min-width: 768px) {
    .example-card:first-child {
      grid-column: 1 / 2;
    }
  }

  .example-card__media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background-color: var(--surface-2);
    border-radius: var(--ala-radius-md) var(--ala-radius-md) 0 0;
  }

  .example-card__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms var(--ease-out-expo);
  }

  .example-card:hover .example-card__media img {
    transform: scale(1.03);
  }

  .example-card__content {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 1.5rem;
  }

  @media (min-width: 1024px) {
    .example-card__content {
      padding: 2rem;
    }
  }

  .example-card__title {
    font-size: var(--text-xl);
    font-weight: 700;
    margin-bottom: 0.75rem;
  }

  .example-card__situation {
    font-size: var(--text-md);
    line-height: 1.55;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }

  .example-card__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .example-card__outcome {
    font-size: var(--text-md);
    font-weight: 500;
    line-height: 1.5;
    color: var(--text);
  }

  @media (prefers-reduced-motion: reduce) {
    .example-card__media img {
      transition: none;
    }

    .example-card:hover .example-card__media img {
      transform: none;
    }
  }
</style>
