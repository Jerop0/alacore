---
import Button from '../ui/Button.astro';
import { DEFAULT_LOCALE, type Locale } from '../../lib/config';
import { localizePath, t } from '../../lib/i18n';
import type { CopyNode } from '../../lib/i18n';

interface Props {
  locale: Locale;
  copy: CopyNode;
}

const { locale, copy } = Astro.props;
---

<section class="hero">
  <div class="hero__bg" aria-hidden="true">
    <img
      src="/images/hero/reception-wall.webp"
      alt=""
      class="hero__bg-img"
      width="1672"
      height="941"
      fetchpriority="high"
    />
    <div class="hero__overlay"></div>
  </div>
  <div class="container hero__content">
    <h1 class="hero__title" data-animate="fade-up">{t(copy, 'hero.title')}</h1>
    <p class="hero__body" data-animate="fade-up" style="--delay: 120ms">{t(copy, 'hero.body')}</p>
    <div class="hero__actions" data-animate="fade-up" style="--delay: 240ms">
      <Button href={localizePath('/solutions', locale, locale)}>
        {t(copy, 'hero.primary')}
      </Button>
      <Button href={localizePath('/contact', locale, locale)} variant="secondary" onDark>
        {t(copy, 'hero.secondary')}
      </Button>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(5, 11, 22, 0.92) 0%,
      rgba(5, 11, 22, 0.45) 38%,
      rgba(5, 11, 22, 0.08) 75%
    );
  }

  html[dir="rtl"] .hero__overlay {
    background: linear-gradient(
      to top,
      rgba(5, 11, 22, 0.92) 0%,
      rgba(5, 11, 22, 0.45) 38%,
      rgba(5, 11, 22, 0.08) 75%
    );
  }

  .hero__content {
    position: relative;
    z-index: 1;
    padding-bottom: 4rem;
    color: var(--ala-pure-white);
  }

  @media (min-width: 768px) {
    .hero__content {
      padding-bottom: 5rem;
    }
  }

  @media (min-width: 1024px) {
    .hero__content {
      padding-bottom: 6rem;
    }
  }

  .hero__title {
    font-size: clamp(28px, 3.5vw, 48px);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--ala-pure-white);
    white-space: nowrap;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (min-width: 1200px) {
    .hero__title {
      font-size: clamp(36px, 4vw, 56px);
    }
  }

  .hero__body {
    margin-top: 1rem;
    font-size: var(--text-lg);
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.9);
    max-width: 54ch;
  }

  @media (min-width: 768px) {
    .hero__body {
      font-size: var(--text-xl);
      margin-top: 1.25rem;
    }
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  @media (min-width: 768px) {
    .hero__actions {
      margin-top: 2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__bg-img {
      transition: none;
    }
  }

  /* Hero entrance animations */
  @media (prefers-reduced-motion: no-preference) {
    .hero__title,
    .hero__body,
    .hero__actions {
      opacity: 0;
      transform: translate3d(0, 28px, 0);
      animation: hero-fade-up 700ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }

    .hero__title {
      animation-delay: 100ms;
    }

    .hero__body {
      animation-delay: 220ms;
    }

    .hero__actions {
      animation-delay: 340ms;
    }

    @keyframes hero-fade-up {
      to {
        opacity: 1;
        transform: translate3d(0, 0, 0);
      }
    }
  }
</style>
