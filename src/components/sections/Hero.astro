---
import Button from '../ui/Button.astro';
import { DEFAULT_LOCALE, type Locale } from '../../lib/config';
import { localizePath, t } from '../../lib/i18n';
import type { CopyNode } from '../../lib/i18n';

interface Props {
  locale: Locale;
  copy: CopyNode;
}

const { locale, copy } = Astro.props;
---

<section class="hero">
  <div class="hero__media">
    <img
      src="/images/hero/reception-wall.png"
      alt="ALA CORE office reception with mounted logo"
      class="hero__image"
      width="1672"
      height="941"
      fetchpriority="high"
    />
  </div>
  <div class="container hero__content">
    <h1 class="hero__title">{t(copy, 'hero.title')}</h1>
    <p class="hero__body">{t(copy, 'hero.body')}</p>
    <div class="hero__actions">
      <Button href={localizePath('/solutions', locale, locale)}>
        {t(copy, 'hero.primary')}
      </Button>
      <Button href={localizePath('/contact', locale, locale)} variant="secondary">
        {t(copy, 'hero.secondary')}
      </Button>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    background-color: var(--bg);
    color: var(--text);
  }

  .hero__media {
    width: 100%;
    overflow: hidden;
  }

  .hero__image {
    display: block;
    width: 100%;
    height: auto;
    max-height: 70vh;
    object-fit: cover;
    object-position: center;
  }

  .hero__content {
    padding-top: 3rem;
    padding-bottom: 4rem;
  }

  @media (min-width: 768px) {
    .hero__content {
      padding-top: 4rem;
      padding-bottom: 5rem;
    }
  }

  @media (min-width: 1024px) {
    .hero__content {
      padding-top: 5rem;
      padding-bottom: 6rem;
    }
  }

  .hero__title {
    font-size: var(--heading-hero);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--text);
    max-width: 20ch;
    text-wrap: balance;
  }

  .hero__body {
    margin-top: 1.25rem;
    font-size: var(--text-xl);
    line-height: 1.55;
    color: var(--text-muted);
    max-width: 54ch;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__image {
      transition: none;
    }
  }
</style>
