---
import Button from '../ui/Button.astro';
import CoreOrbit from './CoreOrbit.astro';
import { DEFAULT_LOCALE, type Locale } from '../../lib/config';
import { localizePath, t } from '../../lib/i18n';
import type { CopyNode } from '../../lib/i18n';

interface Props {
  locale: Locale;
  copy: CopyNode;
}

const { locale, copy } = Astro.props;
---

<section class="hero">
  <div class="container hero__inner">
    <div class="hero__copy">
      <h1 class="hero__title">{t(copy, 'hero.title')}</h1>
      <p class="hero__body">{t(copy, 'hero.body')}</p>
      <div class="hero__actions">
        <Button href={localizePath('/solutions', locale, locale)}>
          {t(copy, 'hero.primary')}
        </Button>
        <Button href={localizePath('/contact', locale, locale)} variant="secondary" onDark>
          {t(copy, 'hero.secondary')}
        </Button>
      </div>
    </div>
    <div class="hero__visual">
      <CoreOrbit />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: calc(600px - 76px);
    padding-top: 64px;
    padding-bottom: 64px;
    background-color: var(--ala-core-ink);
    color: var(--ala-pure-white);
    overflow: hidden;
  }

  @media (min-width: 1024px) {
    .hero {
      min-height: calc(640px - 76px);
      padding-top: 80px;
      padding-bottom: 80px;
    }
  }

  .hero__inner {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .hero__inner {
      grid-template-columns: minmax(0, 560px) 1fr;
      gap: 3rem;
    }
  }

  .hero__copy {
    position: relative;
    z-index: 1;
  }

  .hero__title {
    font-size: var(--heading-hero);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: var(--ala-pure-white);
    max-width: 650px;
  }

  .hero__body {
    margin-top: 1.25rem;
    font-size: var(--text-xl);
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.8);
    max-width: 540px;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .hero__visual {
    position: relative;
    z-index: 0;
  }

  @media (max-width: 1023px) {
    .hero__visual {
      max-width: 420px;
      margin-inline: auto;
    }
  }
</style>
