---
import RichRow from './RichRow.astro';
import Button from '../ui/Button.astro';
import { localizePath } from '../../lib/i18n';
import type { Locale } from '../../lib/config';

interface Item {
  name: string;
  benefit: string;
  howItWorks?: string[];
}

interface Theme {
  title: string;
  intro: string;
  items: Item[];
}

interface Props {
  intro: string;
  themes: Theme[];
  bundle?: { title: string; description: string };
  cta?: string;
  locale: Locale;
}

const { intro, themes, bundle, cta, locale } = Astro.props;
---

<div class="industry-catalog">
  <p class="industry-catalog__intro">{intro}</p>

  <div class="industry-catalog__themes">
    {
      themes.map((theme) => (
        <RichRow
          title={theme.title}
          summary={theme.intro}
          items={theme.items}
        />
      ))
    }
  </div>

  {
    bundle && (
      <div class="industry-catalog__bundle">
        <h3 class="industry-catalog__bundle-title">{bundle.title}</h3>
        <p class="industry-catalog__bundle-desc">{bundle.description}</p>
      </div>
    )
  }

  {
    cta && (
      <div class="industry-catalog__cta">
        <Button href={localizePath('/contact', locale, locale)}>{cta}</Button>
      </div>
    )
  }
</div>

<style>
  .industry-catalog {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .industry-catalog__intro {
    font-size: var(--text-xl);
    line-height: 1.5;
    color: var(--text-muted);
    max-width: 64ch;
  }

  .industry-catalog__themes {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .industry-catalog__bundle {
    padding: 1.5rem;
    border: 1px dashed var(--line);
    border-radius: var(--ala-radius-md);
    background-color: var(--surface);
  }

  .industry-catalog__bundle-title {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--text);
    margin-bottom: 0.5rem;
  }

  .industry-catalog__bundle-desc {
    color: var(--text-muted);
    line-height: 1.6;
  }

  .industry-catalog__cta {
    display: flex;
    justify-content: center;
  }
</style>
