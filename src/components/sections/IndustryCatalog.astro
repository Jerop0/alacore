---
import RichRow from '../sections/RichRow.astro';
import Button from '../ui/Button.astro';
import { localizePath } from '../../lib/i18n';
import type { Locale } from '../../lib/config';

interface Props {
  intro: string;
  themeTitles: Record<string, string>;
  themes: { key: string; items: { name: string; short: string; detail: string; link?: string }[] }[];
  bundle?: { title: string; description: string };
  cta?: string;
  locale: Locale;
}

const { intro, themeTitles, themes, bundle, cta, locale } = Astro.props;
---

<div class="industry-catalog">
  <p class="industry-catalog__intro">{intro}</p>

  <div class="industry-catalog__themes">
    {
      themes.map((theme) => (
        <section class="industry-theme" aria-labelledby={`theme-${theme.key}`}>
          <h3 id={`theme-${theme.key}`} class="industry-theme__title">
            {themeTitles[theme.key] ?? theme.key}
          </h3>
          <div class="industry-theme__items">
            {theme.items.map((item) => (
              <RichRow
                title={item.name}
                summary={item.short}
                expand={{
                  summaryLabel: item.name,
                  content: item.detail,
                }}
              />
            ))}
          </div>
        </section>
      ))
    }
  </div>

  {
    bundle && (
      <div class="industry-catalog__bundle">
        <h3 class="industry-catalog__bundle-title">{bundle.title}</h3>
        <p class="industry-catalog__bundle-desc">{bundle.description}</p>
      </div>
    )
  }

  {
    cta && (
      <div class="industry-catalog__cta">
        <Button href={localizePath('/contact', locale, locale)}>{cta}</Button>
      </div>
    )
  }
</div>

<style>
  .industry-catalog {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .industry-catalog__intro {
    font-size: var(--text-xl);
    line-height: 1.5;
    color: var(--text-secondary);
    max-width: 64ch;
  }

  .industry-catalog__themes {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .industry-theme {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .industry-theme__title {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--text);
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--line);
  }

  .industry-theme__items {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .industry-catalog__bundle {
    padding: 1.5rem;
    border: 1px dashed var(--line);
    border-radius: var(--ala-radius-md);
    background-color: var(--surface);
  }

  .industry-catalog__bundle-title {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--text);
    margin-bottom: 0.5rem;
  }

  .industry-catalog__bundle-desc {
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .industry-catalog__cta {
    display: flex;
    justify-content: center;
  }
</style>
