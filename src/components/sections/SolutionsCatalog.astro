---
import RichRow from '../sections/RichRow.astro';
import Button from '../ui/Button.astro';
import { localizePath, t, tArr } from '../../lib/i18n';
import type { CopyNode } from '../../lib/i18n';
import type { Locale } from '../../lib/config';

interface Props {
  copy: CopyNode;
  techCopy?: CopyNode;
  locale: Locale;
}

const { copy, techCopy, locale } = Astro.props;
const families = tArr(copy, 'families');
const groups = techCopy ? tArr(techCopy, 'groups') : [];
---

<div class="solutions-catalog">
  <div class="solutions-catalog__list">
    {
      families.map((family) => {
        const item = family as unknown as CopyNode;
        const familyTitle = t(item, 'title');
        const familyDescription = t(item, 'description');
        const tools = tArr(item, 'tools');
        const included = tArr(item, 'included');
        const whoFor = t(item, 'whoFor');
        const example = t(item, 'example');
        return (
          <RichRow
            title={familyTitle}
            summary={familyDescription}
            pills={tools}
            expand={{
              summaryLabel: t(copy, 'labels.included'),
              content: '',
            }}
          >
            <ul slot="expand" class="solutions-catalog__included">
              {included.map((inc) => (
                <li>{inc}</li>
              ))}
            </ul>
            <p slot="expand" class="solutions-catalog__meta">
              <strong>{t(copy, 'labels.whoFor')}:</strong> {whoFor}
            </p>
            <p slot="expand" class="solutions-catalog__meta">
              <strong>{t(copy, 'labels.example')}:</strong> {example}
            </p>
          </RichRow>
        );
      })
    }
  </div>

  {
    groups.length > 0 && (
      <section class="solutions-catalog__tech" aria-labelledby="tech-capabilities-heading">
        <h2 id="tech-capabilities-heading" class="solutions-catalog__tech-heading">
          {t(techCopy!, 'title')}
        </h2>
        <p class="solutions-catalog__tech-intro">{t(techCopy!, 'intro')}</p>
        <div class="solutions-catalog__tech-grid">
          {groups.map((group) => {
            const item = group as unknown as CopyNode;
            return (
              <div class="solutions-catalog__tech-group">
                <h3 class="solutions-catalog__tech-group-title">{t(item, 'title')}</h3>
                <div class="solutions-catalog__tech-items">
                  {tArr(item, 'items').map((cap) => (
                    <span class="solutions-catalog__tech-pill">{cap}</span>
                  ))}
                </div>
              </div>
            );
          })}
        </div>
        <p class="solutions-catalog__tech-delivery">{t(techCopy!, 'delivery')}</p>
      </section>
    )
  }

  <div class="solutions-catalog__cta">
    <Button href={localizePath('/contact', locale, locale)}>
      {t(copy, 'cta')}
    </Button>
  </div>
</div>

<style>
  .solutions-catalog {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .solutions-catalog__list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .solutions-catalog__included {
    list-style: disc;
    padding-left: 1.25rem;
    margin: 0 0 1rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .solutions-catalog__included li {
    margin-bottom: 0.35rem;
  }

  .solutions-catalog__meta {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    margin-bottom: 0.5rem;
    line-height: 1.55;
  }

  .solutions-catalog__meta strong {
    color: var(--text);
  }

  .solutions-catalog__tech {
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }

  .solutions-catalog__tech-heading {
    font-size: var(--heading-sm);
    font-weight: 700;
    color: var(--text);
    margin-bottom: 0.75rem;
    text-wrap: balance;
  }

  .solutions-catalog__tech-intro {
    font-size: var(--text-lg);
    line-height: 1.55;
    color: var(--text-secondary);
    max-width: 72ch;
    margin-bottom: 2rem;
  }

  .solutions-catalog__tech-grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 768px) {
    .solutions-catalog__tech-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .solutions-catalog__tech-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .solutions-catalog__tech-group {
    padding: 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--ala-radius-md);
    background-color: var(--bg);
    transition: border-color 180ms var(--ease-out-expo);
  }

  .solutions-catalog__tech-group:hover {
    border-color: var(--accent);
  }

  .solutions-catalog__tech-group-title {
    font-size: var(--text-md);
    font-weight: 700;
    color: var(--text);
    margin-bottom: 0.75rem;
  }

  .solutions-catalog__tech-items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .solutions-catalog__tech-pill {
    display: inline-block;
    padding: 0.25rem 0.625rem;
    border-radius: 9999px;
    background-color: var(--surface);
    color: var(--text-secondary);
    font-size: var(--text-xs);
    font-weight: 500;
    line-height: 1.4;
  }

  .solutions-catalog__tech-delivery {
    margin-top: 2rem;
    padding: 1.5rem;
    border-radius: var(--ala-radius-md);
    background-color: var(--surface);
    font-size: var(--text-lg);
    line-height: 1.55;
    color: var(--text-secondary);
    text-align: center;
  }

  .solutions-catalog__cta {
    text-align: center;
  }
</style>
