---
import RichRow from './RichRow.astro';
import Button from '../ui/Button.astro';
import { localizePath, t, tArr } from '../../lib/i18n';
import type { CopyNode } from '../../lib/i18n';
import type { Locale } from '../../lib/config';

interface Props {
  copy: CopyNode;
  locale: Locale;
}

const { copy, locale } = Astro.props;
const families = (copy.families ?? []) as any[];
---

<div class="solutions-catalog">
  <div class="solutions-catalog__list">
    {
      families.map((family) => {
        const items = family.items ?? [];
        const dialog = family.dialog;
        return (
          <RichRow
            title={family.title}
            summary={family.summary}
            items={items}
            dialog={dialog ? {
              triggerLabel: dialog.triggerLabel,
              title: dialog.title,
              body: dialog.body
            } : undefined}
          />
        );
      })
    }
  </div>

  <div class="solutions-catalog__cta">
    <Button href={localizePath('/contact', locale, locale)}>
      {copy.cta ?? 'Talk to an expert'}
    </Button>
  </div>
</div>

<style>
  .solutions-catalog {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .solutions-catalog__list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .solutions-catalog__cta {
    text-align: center;
  }
</style>
