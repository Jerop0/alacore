---
import Button from '../ui/Button.astro';
import { localizePath, t } from '../../lib/i18n';
import type { CopyNode } from '../../lib/i18n';
import type { Locale } from '../../lib/config';

interface Props {
  locale: Locale;
  copy: CopyNode;
}

const { locale, copy } = Astro.props;

const points = [
  {
    title: t(copy, 'sections.anyIdeaPoint1'),
    body: t(copy, 'sections.anyIdeaPoint1Support'),
    image: '/whatever-you-need/any-idea-made-real.webp',
    accent: '#1D61E7',
  },
  {
    title: t(copy, 'sections.anyIdeaPoint2'),
    body: t(copy, 'sections.anyIdeaPoint2Support'),
    image: '/whatever-you-need/any-technology.webp',
    accent: '#2563EB',
  },
  {
    title: t(copy, 'sections.anyIdeaPoint3'),
    body: t(copy, 'sections.anyIdeaPoint3Support'),
    image: '/whatever-you-need/hard-problems.webp',
    accent: '#1E3A8A',
  },
];
---

<section class="section section--mist any-idea" aria-labelledby="any-idea-heading">
  <div class="container any-idea__inner">
    <div class="any-idea__copy" data-animate="fade-left">
      <h2 id="any-idea-heading" class="any-idea__title">{t(copy, 'sections.anyIdea')}</h2>
      <p class="any-idea__support">{t(copy, 'sections.anyIdeaSupport')}</p>
    </div>

    <ul class="any-idea__points" role="list">
      {
        points.map((point, index) => (
          <li class="any-idea__card" style={`--card-accent: ${point.accent};`} data-animate="fade-right" data-delay={index * 100}>
            <div class="any-idea__media">
              <img
                src={point.image}
                alt={`${point.title} illustration`}
                width="720"
                height="480"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="any-idea__card-body">
              <h3>{point.title}</h3>
              <p>{point.body}</p>
            </div>
          </li>
        ))
      }
    </ul>

    <div class="any-idea__actions" data-animate="fade-up" data-delay={points.length * 100}>
      <Button id="any-idea-ask-ala">{t(copy, 'sections.anyIdeaCtaPrimary')}</Button>
      <Button href={localizePath('/contact', locale, locale)} variant="secondary">
        {t(copy, 'sections.anyIdeaCtaSecondary')}
      </Button>
    </div>
  </div>
</section>

<script>
  (function () {
    const btn = document.getElementById('any-idea-ask-ala');
    if (!btn) return;
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      window.dispatchEvent(new CustomEvent('open-ask-ala'));
    });
  })();
</script>

<style>
  .any-idea__inner {
    display: block;
  }

  .any-idea__title {
    font-size: var(--heading-sm);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .any-idea__support {
    max-width: 64ch;
    margin-top: 1rem;
    font-size: var(--text-lg);
    line-height: 1.55;
    color: var(--text-muted);
  }

  .any-idea__points {
    display: grid;
    gap: 1rem;
    margin-top: 2rem;
    list-style: none;
    padding: 0;
  }

  @media (min-width: 768px) {
    .any-idea__points {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
    }
  }

  .any-idea__card {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--ala-radius-md);
    background-color: var(--bg);
    box-shadow: var(--shadow-card);
    transition:
      border-color 200ms var(--ease-out-expo),
      transform 200ms var(--ease-out-expo),
      box-shadow 200ms var(--ease-out-expo);
  }

  .any-idea__card::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background-color: var(--card-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 220ms var(--ease-out-expo);
    z-index: 1;
  }

  .any-idea__media {
    aspect-ratio: 16 / 9;
    display: grid;
    place-items: center;
    padding: 0.75rem;
    background-color: #f1f5fb;
    border-bottom: 1px solid var(--line);
  }

  .any-idea__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .any-idea__card-body {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1.375rem 1.5rem 1.5rem;
  }

  .any-idea__card-body h3 {
    font-size: var(--text-md);
    font-weight: 700;
    color: var(--text);
    transition: color 180ms var(--ease-out-expo);
  }

  .any-idea__card-body p {
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--text-muted);
  }

  .any-idea__card:hover,
  .any-idea__card:focus-within {
    transform: translateY(-4px);
    border-color: var(--card-accent);
    box-shadow:
      0 18px 40px -18px color-mix(in srgb, var(--card-accent) 50%, transparent),
      var(--shadow-card);
  }

  .any-idea__card:hover::before,
  .any-idea__card:focus-within::before {
    transform: scaleX(1);
  }

  .any-idea__card:hover .any-idea__card-body h3 {
    color: var(--card-accent);
  }

  .any-idea__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .any-idea__card,
    .any-idea__card::before {
      transition: none;
    }

    .any-idea__card:hover,
    .any-idea__card:focus-within {
      transform: none;
    }
  }
</style>
