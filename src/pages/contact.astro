---
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Button from '../components/ui/Button.astro';
import ContactForm from '../components/forms/ContactForm.astro';
import { EMAIL, DEFAULT_LOCALE, type Locale } from '../lib/config';
import { getCopy, getSeo } from '../lib/page';
import { t } from '../lib/i18n';

const currentLocale = (Astro.currentLocale as Locale) ?? DEFAULT_LOCALE;
const copy = getCopy(currentLocale, 'contact');
const siteCopy = getCopy(currentLocale, 'site');
const seo = getSeo(currentLocale, 'contact');
---

<Layout title={seo.title} description={seo.description}>
  <section class="section">
    <div class="container contact-layout">
      <div class="contact-intro">
        <SectionHeading title={t(copy, 'title')} supporting={t(copy, 'intro')} />
        <div class="contact-alternatives">
          <p>{t(copy, 'emailIntro')} <a href={`mailto:${EMAIL}`}>{EMAIL}</a></p>
          <p>
            {t(copy, 'askAla')}
            <Button variant="ghost" id="contact-ask-ala">{t(siteCopy, 'finalCtaSecondary')}</Button>
          </p>
        </div>
      </div>

      <div class="contact-form-wrapper">
        <ContactForm locale={currentLocale} copy={copy} />
      </div>
    </div>
  </section>
</Layout>

<script>
  (function () {
    const btn = document.getElementById('contact-ask-ala');
    if (!btn) return;
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      window.dispatchEvent(new CustomEvent('open-ask-ala'));
    });
  })();
</script>

<style>
  .contact-layout {
    display: grid;
    gap: 3rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 1024px) {
    .contact-layout {
      grid-template-columns: 1fr 1.2fr;
      align-items: start;
    }
  }

  .contact-intro {
    max-width: 520px;
  }

  .contact-alternatives {
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    font-size: var(--text-md);
    color: var(--text-muted);
  }

  .contact-alternatives a {
    color: var(--accent);
    font-weight: 600;
  }

  .contact-alternatives a:hover {
    color: var(--accent-hover);
  }

  .contact-form-wrapper {
    padding: 2rem;
    border-radius: var(--ala-radius-lg);
    background-color: var(--surface);
  }

  @media (min-width: 768px) {
    .contact-form-wrapper {
      padding: 2.5rem;
    }
  }
</style>
