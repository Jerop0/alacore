---
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import SolutionsCatalog from '../components/sections/SolutionsCatalog.astro';
import ProcessSteps from '../components/sections/ProcessSteps.astro';
import FinalCta from '../components/sections/FinalCta.astro';
import { DEFAULT_LOCALE, type Locale } from '../lib/config';
import { getCopy, getSeo } from '../lib/page';
import { t } from '../lib/i18n';

const currentLocale = (Astro.currentLocale as Locale) ?? DEFAULT_LOCALE;
const copy = getCopy(currentLocale, 'solutions');
const techCopy = getCopy(currentLocale, 'tech');
const siteCopy = getCopy(currentLocale, 'site');
const seo = getSeo(currentLocale, 'solutions');
---

<Layout title={seo.title} description={seo.description}>
  <section class="section">
    <div class="container">
      <SectionHeading title={t(copy, 'title')} supporting={t(copy, 'intro')} />
      <SolutionsCatalog copy={copy} techCopy={techCopy} locale={currentLocale} />
    </div>
  </section>

  <ProcessSteps copy={siteCopy} locale={currentLocale} />
  <FinalCta locale={currentLocale} copy={siteCopy} />
</Layout>
